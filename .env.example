# Firebase Configuration for NER-LIFELINE
# Replace with your Firebase Project credentials from the Firebase Console:
# Project Settings -> General -> Your apps -> Web app -> Firebase SDK snippet -> Config

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=ner-lifeline.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ner-lifeline
VITE_FIREBASE_STORAGE_BUCKET=ner-lifeline.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
